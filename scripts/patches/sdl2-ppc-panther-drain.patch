--- a/src/file/cocoa/SDL_rwopsbundlesupport.m
+++ b/src/file/cocoa/SDL_rwopsbundlesupport.m
@@ -63,7 +63,12 @@ FILE* SDL_OpenFPFromBundleOrFallback(const char *file, const char *mode)
         fp = fopen(file, mode);
     }

-    [autorelease_pool drain];
+    /* alephone#37: -drain is an NSAutoreleasePool method Apple added in
